NODE_ENV=development
PORT=3001

# Postgres (Supabase)
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SSL=true

# Auth — TCLogi ya no tiene login propio, el único camino es un token RS256
# emitido por TCSoft's Core (tcsoft-gateway-back). Ver core-jwt.strategy.ts.
# URL del JWKS de Core, para validar el token localmente sin round-trip a
# Core por request. Ruta completa, incluyendo /api/auth/.well-known/jwks.json.
CORE_JWKS_URL=http://localhost:3010/api/auth/.well-known/jwks.json
# Base URL de la API de Core — usado para GET /subscriptions/me al
# mirrorear plan/estado localmente (ver core-jwt.strategy.ts).
CORE_AUTH_URL=http://localhost:3010/api

# Payment gateways (billing)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Tracking provider (GPS)
TRACKING_WEBHOOK_SECRET=
